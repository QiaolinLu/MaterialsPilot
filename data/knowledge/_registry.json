{
  "_metadata": {
    "description": "Knowledge Registry for Hierarchical Text-to-Structure RAG Framework",
    "version": "4.0.0",
    "last_updated": "2026-11-03",
    "purpose": "Three levels: L1 foundation (including shared API and constraints), L2 structures, L3 applications"
  },
  "knowledge_levels": {
    "L1_foundation": {
      "description": "Universal element data and physical/chemical principles (original L0 plus L1)",
      "always_loaded": true,
      "categories": [
        "periodic_table",
        "ionic_radii",
        "bond_lengths",
        "oxidation_states",
        "physical_principles",
        "chemical_trends",
        "estimation_rules",
        "interface_principles",
        "material_inference_rules"
      ],
      "subcategories": {
        "shared": [
          "pymatgen_api",
          "physical_constraints"
        ]
      }
    },
    "L2_structures": {
      "description": "Structure-type specific knowledge loaded based on target structure",
      "always_loaded": false,
      "subcategories": {
        "bulk": [
          "crystal_structures",
          "structure_types",
          "metal_properties",
          "space_groups",
          "wyckoff_positions"
        ],
        "surface": [
          "surface_sites",
          "surface_structures",
          "periodic_geometry"
        ],
        "defect": [
          "defect_physics",
          "defect_construction",
          "formation_energies",
          "substitution_rules",
          "complex_defects",
          "interstitial_sites",
          "advanced_structures"
        ],
        "interface": [
          "interface_types",
          "grain_boundary",
          "construction_patterns"
        ],
        "framework": [
          "topologies",
          "common_mofs",
          "sbu_library",
          "linker_library"
        ],
        "atom_operations": [
          "geometry",
          "operations"
        ]
      }
    },
    "L3_applications": {
      "description": "Application-specific knowledge for specialized tasks",
      "always_loaded": false,
      "subcategories": {
        "catalysis": [
          "adsorbate_chemistry",
          "coadsorption_interactions",
          "adsorption_energies",
          "scaling_relations",
          "surface_energies",
          "adsorbate_placement",
          "adsorption_construction"
        ],
        "gas_storage": [],
        "electronics": []
      }
    }
  },
