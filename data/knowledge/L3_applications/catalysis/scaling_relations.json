      },
      "olefin_vs_paraffin": {
        "descriptor": "E_H",
        "olefin_selective": "weak H binding"
      }
    }
  },
  "breaking_scaling": {
    "description": "Strategies to break unfavorable scaling relations",
    "strategies": [
      {
        "name": "Bifunctional catalysts",
        "description": "Different sites for different intermediates",
        "example": "Pt-Ru for CO oxidation"
      },
      {
        "name": "Confinement effects",
        "description": "Pore/cavity effects modify scaling",
        "example": "Zeolite-encapsulated metals"
      },
      {
        "name": "Electric field effects",
        "description": "Applied field shifts binding differently for different species",
        "example": "Electrochemical promotion"
      },
      {
        "name": "Strain engineering",
        "description": "Lattice strain modifies d-band and scaling",
        "example": "Core-shell nanoparticles"
      },
      {
        "name": "Single atom catalysts",
        "description": "Isolated atoms have different scaling",
        "example": "Pt1/CeO2"
      },
      {
        "name": "Frustrated Lewis pairs",
        "description": "Separate acid-base sites",
        "example": "H2 activation on oxides"
      }
    ]
  },
  "computational_notes": {
    "functional_dependence": {
      "description": "DFT functional affects absolute values but not trends",
      "PBE_vs_RPBE": "RPBE gives ~0.2-0.3 eV weaker binding than PBE",
      "BEEF_vdW": "Includes van der Waals, better for physisorption"
    },
    "coverage_effects": {
      "description": "Scaling relations derived at low coverage",
      "high_coverage": "Lateral interactions can modify slopes"
    },
    "surface_dependence": {
      "description": "Relations are surface-specific",
      "close_packed": "Most scaling relations derived for (111)/(0001)",
      "stepped": "Different slopes for undercoordinated sites"
    }
  }
}