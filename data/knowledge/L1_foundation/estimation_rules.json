  "surface_energy_estimation": {
    "description": "Rules for estimating surface energies",
    "methods": [
      {
        "name": "broken_bond_model",
        "description": "Surface energy from number of broken bonds",
        "formula": "γ ≈ (Z_bulk - Z_surf) * E_bond / (2 * A)",
        "coordination_numbers": {
          "fcc_111": {
            "bulk": 12,
            "surface": 9
          },
          "fcc_100": {
            "bulk": 12,
            "surface": 8
          },
          "fcc_110": {
            "bulk": 12,
            "surface": 7
          },
          "bcc_110": {
            "bulk": 8,
            "surface": 6
          },
          "bcc_100": {
            "bulk": 8,
            "surface": 4
          }
        }
      },
      {
        "name": "surface_energy_ordering",
        "description": "General ordering of surface energies",
        "fcc_ordering": "γ(111) < γ(100) < γ(110)",
        "bcc_ordering": "γ(110) < γ(100) < γ(111)",
        "hcp_ordering": "γ(0001) < γ(10-10) < γ(11-20)"
      }
    ]
  },
  "usage_guidelines": {
    "when_to_use": [
      "Material not found in static knowledge base",
      "Need to estimate properties for alloys or mixed compositions",
      "Validating LLM-generated values against physical expectations",
      "Providing bounds or sanity checks for calculations"
    ],
    "limitations": [
      "Estimates have typical errors of 10-20%",
      "May not capture complex electronic effects",
      "Alloy estimates assume random mixing",
      "Surface reconstructions not accounted for"
    ],
    "best_practices": [
      "Always state that values are estimates when using these rules",
      "Provide uncertainty ranges when possible",
      "Cross-check with multiple estimation methods",
      "Use experimental data when available"
    ]
  }
