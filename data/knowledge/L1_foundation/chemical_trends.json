  "property_correlations": {
    "melting_point_vs_cohesive_energy": {
      "description": "Higher cohesive energy → higher melting point",
      "correlation": "T_m ≈ 120 * E_coh (K, eV)",
      "examples": {
        "W": {
          "E_coh": 8.9,
          "T_m": 3695
        },
        "Fe": {
          "E_coh": 4.3,
          "T_m": 1811
        },
        "Cu": {
          "E_coh": 3.5,
          "T_m": 1358
        },
        "Al": {
          "E_coh": 3.4,
          "T_m": 933
        }
      }
    },
    "hardness_vs_shear_modulus": {
      "description": "Harder materials have higher shear modulus",
      "correlation": "H ≈ 0.15 * G (GPa)",
      "note": "Approximate for metals"
    },
    "thermal_conductivity_vs_electrical": {
      "description": "Wiedemann-Franz law for metals",
      "formula": "κ / σT = L (Lorenz number)",
      "L_value": "2.44 × 10^-8 W·Ω/K²"
    },
    "band_gap_vs_lattice_constant": {
      "description": "For semiconductors in same family",
      "trend": "Larger lattice constant → smaller band gap",
      "example": "GaAs (5.65 Å, 1.42 eV) vs InAs (6.06 Å, 0.35 eV)"
    }
  },
  "estimation_from_neighbors": {
    "description": "Estimate properties of unknown materials from periodic table neighbors",
    "method": [
      "1. Identify the element's position in periodic table",
      "2. Find known properties of neighboring elements",
      "3. Interpolate based on periodic trends",
      "4. Apply corrections for specific effects (d-electron count, etc.)"
    ],
    "example": {
      "unknown": "Tc (technetium)",
      "neighbors": {
        "Mo": {
          "a": 3.15,
          "T_m": 2896
        },
        "Ru": {
          "a": 2.71,
          "T_m": 2607
        }
      },
      "estimate": "Tc should have properties between Mo and Ru"
    }
  }
