  "periodic_trends": {
    "atomic_radius": {
      "description": "Size of atoms across the periodic table",
      "trends": {
        "across_period": "Decreases left to right (more protons, same shell)",
        "down_group": "Increases top to bottom (more electron shells)"
      },
      "implications": [
        "Larger atoms → larger lattice constants",
        "Size mismatch affects solid solubility (Hume-Rothery)",
        "Affects coordination preferences in compounds"
      ],
      "reference_values_pm": {
        "group_1": {
          "Li": 152,
          "Na": 186,
          "K": 227,
          "Rb": 248,
          "Cs": 265
        },
        "group_2": {
          "Be": 112,
          "Mg": 160,
          "Ca": 197,
          "Sr": 215,
          "Ba": 222
        },
        "group_11": {
          "Cu": 128,
          "Ag": 144,
          "Au": 144
        },
        "group_10": {
          "Ni": 124,
          "Pd": 137,
          "Pt": 139
        }
      }
    },
    "electronegativity": {
      "description": "Tendency to attract electrons in a bond",
      "trends": {
        "across_period": "Increases left to right",
        "down_group": "Decreases top to bottom"
      },
      "scale": "Pauling scale (F = 4.0 is highest)",
      "implications": [
        "Large difference → ionic bonding",
        "Small difference → covalent bonding",
        "Affects charge transfer in compounds"
      ],
      "reference_values": {
        "nonmetals": {
          "F": 4.0,
          "O": 3.5,
          "N": 3.0,
          "Cl": 3.2,
          "C": 2.5,
          "S": 2.6
        },
        "metals": {
          "Au": 2.5,
          "Pt": 2.3,
          "Pd": 2.2,
          "Ag": 1.9,
          "Cu": 1.9,
          "Fe": 1.8,
          "Al": 1.6
        }
      }
    },
    "ionization_energy": {
      "description": "Energy to remove an electron",
      "trends": {
        "across_period": "Increases left to right",
        "down_group": "Decreases top to bottom"
      },
      "implications": [
        "Low IE → easily forms cations (metals)",
        "High IE → resists electron loss (nonmetals)",
        "Affects oxidation states"
      ]
    },
    "electron_affinity": {
      "description": "Energy released when gaining an electron",
      "trends": {
        "across_period": "Generally increases (with exceptions)",
        "down_group": "Generally decreases"
      },
      "implications": [
        "High EA → easily forms anions",
        "Affects reduction potential"
      ]
    },
    "metallic_character": {
      "description": "Tendency to exhibit metallic properties",
      "trends": {
        "across_period": "Decreases left to right",
        "down_group": "Increases top to bottom"
      },
      "boundary": "Metalloids (B, Si, Ge, As, Sb, Te) at metal-nonmetal boundary"
    }
  },
