  "surface_construction_rules": {
    "symmetric_slab": {
      "description": "Equivalent top and bottom surfaces",
      "advantage": "A symmetric charge distribution cancels the normal dipole; verify termination and charge after modifications",
      "pymatgen": "slab_gen.get_slabs(symmetrize=True)"
    },
    "asymmetric_slab": {
      "description": "Different terminations on top and bottom",
      "use_case": "When studying specific termination",
      "note": "May have dipole correction needed"
    },
    "vacuum_size": {
      "minimum": 10,
      "recommended": 15,
      "for_molecules": 20,
      "unit": "Angstrom",
      "scope": "Illustrative starting sizes; converge vacuum for the material, adsorbate and observable"
    },
    "k_point_sampling": {
      "rule": "Dense in surface directions, 1 in vacuum direction",
      "example": "6x6x1 for surface calculations"
    }
  },
  "pymatgen_construction": {
    "imports": [
      "from pymatgen.core import Structure",
      "from pymatgen.core.surface import SlabGenerator, generate_all_slabs"
    ],
    "basic_slab": {
      "code": "SlabGenerator(bulk, miller_index, min_slab_size, min_vacuum_size)",
      "parameters": {
        "bulk": "Bulk Structure object",
        "miller_index": "Tuple like (1, 1, 1)",
        "min_slab_size": "Minimum slab thickness in Angstrom",
        "min_vacuum_size": "Vacuum thickness in Angstrom"
      }
    },
    "get_slabs": {
      "method": "slabs = slab_gen.get_slabs()",
      "returns": "List of Slab objects with different terminations"
    },
    "supercell": {
      "method": "slab.make_supercell([m, n, 1])",
      "note": "Expand lattice vectors a,b when they span the surface; [m,n,1] refers to lattice directions, not global Cartesian x,y,z"
    }
  }
}
