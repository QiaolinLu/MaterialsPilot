  "charge_compensation_mechanisms": {
    "description": "How charge balance is maintained for aliovalent substitution",
    "mechanisms": {
      "vacancy_formation": {
        "description": "Create vacancies to balance charge",
        "example": "2Al3+ + V_O for 2Ti4+ in TiO2"
      },
      "interstitial_formation": {
        "description": "Add interstitials to balance charge",
        "example": "Li+ interstitial for Al3+ substituting Si4+"
      },
      "electronic_compensation": {
        "description": "Free carriers compensate charge",
        "example": "P5+ for Si4+ creates free electron"
      },
      "coupled_substitution": {
        "description": "Two substitutions that together maintain charge",
        "example": "Ca2+ + Al3+ for 2Si4+ in silicates"
      }
    }
  },
  "prediction_guidelines": {
    "favorable_substitution": [
      "Size mismatch < 15%",
      "Same or similar oxidation state",
      "Similar electronegativity (within 0.4)",
      "Same preferred coordination number",
      "Same crystal structure preference"
    ],
    "unfavorable_substitution": [
      "Size mismatch > 30%",
      "Very different oxidation states without compensation",
      "Large electronegativity difference (> 1.0)",
      "Different coordination preferences",
      "Tendency to form competing compounds"
    ],
    "special_considerations": [
      "Jahn-Teller active ions (Cu2+, Mn3+) have specific site preferences",
      "Magnetic ions may have spin-state dependent radii",
      "d0 and d10 ions are often more flexible in coordination",
      "Lanthanides prefer high coordination numbers (8-12)"
    ]
  }
