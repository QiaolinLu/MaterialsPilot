  "hume_rothery_rules": {
    "description": "Classical rules for substitutional solid solution formation in metals",
    "rules": {
      "size_factor": {
        "description": "Atomic radii should differ by less than 15%",
        "formula": "|r1 - r2| / r1 < 0.15",
        "importance": "critical",
        "notes": "Larger size difference leads to lattice strain and limited solubility"
      },
      "electronegativity": {
        "description": "Similar electronegativity favors solid solution",
        "formula": "|EN1 - EN2| < 0.4",
        "importance": "moderate",
        "notes": "Large difference leads to compound formation instead"
      },
      "valence": {
        "description": "Similar valence electrons favor substitution",
        "importance": "moderate",
        "notes": "Higher valence solute in lower valence solvent has higher solubility"
      },
      "crystal_structure": {
        "description": "Same crystal structure favors complete miscibility",
        "importance": "high",
        "notes": "Different structures limit solubility"
      }
    }
  },
  "ionic_substitution_rules": {
    "description": "Rules for ionic compound substitution (Pauling rules extension)",
    "rules": {
      "charge_balance": {
        "description": "Total charge must be maintained",
        "importance": "critical",
        "examples": [
          "Al3+ for Si4+ requires charge compensation",
          "Ca2+ for Na+ requires vacancy or interstitial"
        ]
      },
      "ionic_radius_match": {
        "description": "Ionic radii should match within ~15% for same coordination",
        "importance": "high",
        "notes": "Use Shannon ionic radii for appropriate oxidation state and CN"
      },
      "coordination_preference": {
        "description": "Substituent should prefer similar coordination environment",
        "importance": "moderate"
      }
    }
  },
