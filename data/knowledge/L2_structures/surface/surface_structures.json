{
  "_metadata": {
    "description": "Comprehensive surface structure knowledge for slab construction",
    "purpose": "Enable accurate surface slab generation for any metal or oxide",
    "source": "Surface science literature and DFT calculations",
    "version": "2026.11-r4",
    "last_updated": "2026-11-03",
    "source_urls": [
      "https://docs.ase-lib.org/_modules/ase/build/surface.html",
      "https://pymatgen.org/pymatgen.core.html#pymatgen.core.surface.SlabGenerator.get_slabs"
    ]
  },
  "fcc_surfaces": {
    "(111)": {
      "symmetry": "p3m1 (hexagonal)",
      "surface_atoms_per_layer": 1,
      "coordination_number": 9,
      "surface_energy_rank": 1,
      "description": "Most stable, close-packed surface",
      "stacking": "ABCABC",
      "interlayer_spacing": "a/sqrt(3)",
      "adsorption_sites": {
        "top": {
          "coordination": 1
        },
        "bridge": {
          "coordination": 2
        },
        "fcc_hollow": {
          "coordination": 3,
          "note": "No atom directly below in the second substrate layer; this does not exclude deeper-layer atoms",
          "second_layer_atom_below": false
        },
        "hcp_hollow": {
          "coordination": 3,
          "note": "Above an atom in the second substrate layer",
          "second_layer_atom_below": true
        }
      },
      "reconstruction": {
        "Au(111)": "22 x sqrt(3) herringbone",
        "Pt(111)": "No reconstruction"
      },
      "slab_parameters": {
        "min_layers": 4,
        "recommended_layers": 6,
        "vacuum": 15
      },
      "site_coordinate_scope": "Use actual surface neighbors and periodic images; fractional offsets depend on the basis."
    },
    "(100)": {
      "symmetry": "p4mm (square)",
      "surface_atoms_per_layer": 1,
      "coordination_number": 8,
      "surface_energy_rank": 2,
