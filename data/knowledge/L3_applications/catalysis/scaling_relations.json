      "unit": "eV",
      "top_catalysts": [
        "Au",
        "Ag",
        "Zn"
      ],
      "notes": "Weak CO binding favors CO desorption"
    },
    "CO2RR_to_CH4": {
      "descriptor": "E_CO",
      "optimal_value": -0.8,
      "unit": "eV",
      "top_catalysts": [
        "Cu"
      ],
      "notes": "Moderate CO binding allows further reduction"
    },
    "NH3_synthesis": {
      "descriptor": "E_N",
      "optimal_value": -0.5,
      "unit": "eV",
      "top_catalysts": [
        "Ru",
        "Fe",
        "Os"
      ],
      "notes": "Trade-off between N2 activation and NH3 desorption"
    },
    "NO_reduction": {
      "descriptor": "E_N",
      "optimal_value": -0.8,
      "unit": "eV",
      "top_catalysts": [
        "Rh",
        "Pt",
        "Pd"
      ],
      "notes": "Automotive three-way catalyst"
    },
    "methanol_synthesis": {
      "descriptor": "E_CO + E_O",
      "optimal_value": -2.5,
      "unit": "eV",
      "top_catalysts": [
        "Cu/ZnO/Al2O3"
      ],
      "notes": "Industrial catalyst for CO2 hydrogenation"
    }
  },
  "selectivity_descriptors": {
    "description": "Descriptors for reaction selectivity",
    "CO2RR_selectivity": {
      "CO_vs_HCOO": {
        "descriptor": "E_COOH - E_HCOO",
        "CO_selective": "< 0",
        "HCOO_selective": "> 0"
      },
      "C1_vs_C2": {
        "descriptor": "E_CO",
        "C2_favorable": "moderate E_CO (-0.6 to -0.9 eV)",
        "notes": "Cu is unique in producing C2+ products"
      }
    },
    "Fischer_Tropsch": {
      "chain_growth_probability": {
        "descriptor": "E_C",
        "high_alpha": "strong C binding",
